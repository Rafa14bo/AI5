import { createFileRoute } from "@tanstack/react-router";
import { Header } from "@/components/site/header";
import { Hero } from "@/components/site/hero";
import { Sobre } from "@/components/site/sobre";
import { Servicos } from "@/components/site/servicos";
import { Diferenciais } from "@/components/site/diferenciais";
import { Projetos } from "@/components/site/projetos";
import { Galeria } from "@/components/site/galeria";
import { Localizacao } from "@/components/site/localizacao";
import { Contato } from "@/components/site/contato";
import { CtaFinal } from "@/components/site/cta-final";
import { Footer } from "@/components/site/footer";
import { WhatsAppFlutuante } from "@/components/site/whatsapp-flutuante";
import { empresa } from "@/lib/riomar";

const titulo = "RIOMAR CONSTRUÇÃO — Materiais de construção em Barretos, SP";
const descricao =
  "Loja de materiais de construção em Barretos - SP. Revestimentos, tintas, material elétrico e hidráulico, ferragens e concreto. Orçamento pelo WhatsApp.";

export const Route = createFileRoute("/")({
  component: Index,
  head: () => ({
    meta: [
      { title: titulo },
      { name: "description", content: descricao },
      { property: "og:title", content: titulo },
      { property: "og:description", content: descricao },
      { property: "og:type", content: "website" },
      { property: "og:url", content: "/" },
      { property: "og:locale", content: "pt_BR" },
      { name: "twitter:card", content: "summary_large_image" },
    ],
    links: [{ rel: "canonical", href: "/" }],
    scripts: [
      {
        type: "application/ld+json",
        children: JSON.stringify({
          "@context": "https://schema.org",
          "@type": "HardwareStore",
          name: empresa.nome,
          description: descricao,
          telephone: "+55 17 3321-0300",
          address: {
            "@type": "PostalAddress",
            streetAddress: "Av. Messias Gonçalves, 1241",
            addressLocality: "Barretos",
            addressRegion: "SP",
            postalCode: "14781-090",
            addressCountry: "BR",
          },
          geo: {
            "@type": "GeoCoordinates",
            latitude: empresa.coords.lat,
            longitude: empresa.coords.lng,
          },
          sameAs: [empresa.instagram, empresa.linktree],
          hasMap: empresa.maps,
        }),
      },
    ],
  }),
});

function Index() {
  return (
    <div className="min-h-screen overflow-x-hidden">
      <Header />
      <main>
        <Hero />
        <Sobre />
        <Servicos />
        <Diferenciais />
        <Projetos />
        <Galeria />
        <Localizacao />
        <Contato />
        <CtaFinal />
      </main>
      <Footer />
      <WhatsAppFlutuante />
    </div>
  );
}
